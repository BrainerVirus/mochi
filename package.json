{
  "name": "mochi",
  "version": "0.5.0",
  "private": true,
  "description": "Cross-platform desktop companion for tracking AI coding tool usage — tray, widget, settings, and CLI.",
  "keywords": [
    "ai",
    "ai-coding",
    "claude",
    "codex",
    "cursor",
    "desktop-app",
    "mochi",
    "react",
    "tanstack-router",
    "tauri",
    "tray-app",
    "usage-tracker"
  ],
  "homepage": "https://github.com/BrainerVirus/mochi#readme",
  "bugs": {
    "url": "https://github.com/BrainerVirus/mochi/issues"
  },
  "license": "MIT",
  "author": "Cristhofer Pincetti <86972354+BrainerVirus@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainerVirus/mochi.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "check:diagnostics-cli": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- diagnostics",
    "check:tauri-frontend": "node scripts/check-tauri-frontend-dist.mjs",
    "dev": "vite dev --port 1420",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --react-plugin --jsx-a11y-plugin --import-plugin --deny-warnings app src",
    "preview": "vite preview",
    "start": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "MOCHI_DEV_SHOW_MAIN=1 pnpm tauri dev",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:release": "vitest run scripts/release/*.test.mjs",
    "test:scripts": "vitest run --config vitest.config.ts scripts/",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.0.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "^16.8.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.78.0",
    "oxlint-tailwindcss": "^1.10.2",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.15.0 <10"
  },
  "packageManager": "pnpm@9.15.9"
}
